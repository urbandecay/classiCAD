#version 330 core

void main()
{
    // Fullscreen triangle; interpolation is unnecessary in the resolve pass.
    vec2 position = vec2((gl_VertexID << 1) & 2, gl_VertexID & 2);
    gl_Position = vec4(position * 2.0 - 1.0, 0.0, 1.0);
}
